<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TodoApp.Api</RootNamespace>
    <!-- The React build drops its bundle here; keep it out of source control. -->
    <SpaRoot>../todo-web</SpaRoot>
    <!-- Precompressed .br/.gz copies are only served by MapStaticAssets, which this app
         does not use, so skip generating them. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <!-- Required explicitly by the Cosmos SDK, which still uses it on internal code
         paths even though our documents serialize via System.Text.Json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
